              "raw": "{\n  \"name\": \"Compras Asado de Domingo\",\n  \"items\": [\n    \"Carne de res para asar\",\n    \"Carbón vegetal\",\n    \"Guacamole\",\n    \"Arepas de maíz\",\n    \"Bebidas gaseosas\"\n  ]\n}"
