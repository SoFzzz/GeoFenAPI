              "raw": "{\n  \"name\": \"Éxito Panamericana\",\n  \"chain\": \"Éxito\",\n  \"address\": \"Av. Panamericana # 22-10, Pasto, Nariño\",\n  \"latitude\": 1.2136,\n  \"longitude\": -77.2811,\n  \"schedule\": \"Lun-Dom 8:00-21:00\"\n}"
