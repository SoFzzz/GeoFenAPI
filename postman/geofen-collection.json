            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Compras Asado de Domingo\",\n  \"items\": [\n    \"Carne de res para asar\",\n    \"Carbón vegetal\",\n    \"Guacamole\",\n    \"Arepas de maíz\",\n    \"Bebidas gaseosas\"\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:3000/lists",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["lists"]
            },
            "description": "Crea una nueva lista con CreateListDto válido y responde HTTP 201 Created."
          },
          "response": []
        },
        {
          "name": "6. POST - Error 400 Validación DTO (class-validator)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"items\": \"no-es-un-arreglo\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/lists",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["lists"]
            },
            "description": "Demuestra el rechazo automático por ValidationPipe con mensajes explicativos de @IsNotEmpty y @IsArray."
