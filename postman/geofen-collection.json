          },
          "response": []
        },
        {
          "name": "4. GET - Error 400 ID inválido (ParseIntPipe)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/lists/no-es-un-numero",
              "protocol": "http",
              "host": ["localhost"],
