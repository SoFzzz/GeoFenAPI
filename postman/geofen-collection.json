    {
      "name": "Tiendas (Stores CRUD)",
      "item": [
        {
          "name": "1. GET - Obtener todas las tiendas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/stores",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["stores"]
            },
            "description": "Retorna las tiendas guardadas en PostgreSQL (HTTP 200). Si la base está vacía, retorna un arreglo vacío."
          },
          "response": []
        },
        {
          "name": "2. GET - Obtener tienda por ID (Éxito)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/stores/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["stores", "1"]
            },
            "description": "Retorna la tienda con ID 1 (HTTP 200). Requiere haber creado una tienda con el POST de éxito."
          },
          "response": []
        },
        {
          "name": "3. GET - Error 404 Tienda no encontrada",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/stores/888",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["stores", "888"]
            },
            "description": "Lanza NotFoundException temprana si la tienda no existe (HTTP 404)."
          },
          "response": []
        },
        {
          "name": "4. POST - Crear tienda (Éxito)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Éxito Panamericana\",\n  \"chain\": \"Éxito\",\n  \"address\": \"Av. Panamericana # 22-10, Pasto, Nariño\",\n  \"latitude\": 1.2136,\n  \"longitude\": -77.2811,\n  \"schedule\": \"Lun-Dom 8:00-21:00\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/stores",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["stores"]
            },
            "description": "Crea una tienda nueva y responde HTTP 201 Created con el ID asignado. Ejecutar antes de las pruebas que usan ID 1."
          },
          "response": []
        },
        {
          "name": "5. POST - Error 409 Tienda duplicada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Éxito Panamericana\",\n  \"chain\": \"Éxito\",\n  \"address\": \"Av. Panamericana # 22-10, Pasto, Nariño\",\n  \"latitude\": 1.2136,\n  \"longitude\": -77.2811,\n  \"schedule\": \"Lun-Dom 8:00-21:00\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/stores",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["stores"]
            },
            "description": "Intenta crear una tienda con la misma chain y address que la tienda ya creada. Responde HTTP 409 Conflict. Ejecutar después del POST de éxito."
          },
          "response": []
        },
        {
          "name": "6. POST - Error 400 Validación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"chain\": \"Éxito\",\n  \"address\": \"Calle 1 # 2-3, Pasto\",\n  \"latitude\": 95,\n  \"longitude\": -200\n}"
            },
            "url": {
              "raw": "http://localhost:3000/stores",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["stores"]
            },
            "description": "Nombre vacío, latitud fuera de rango (mayor a 90) y longitud fuera de rango (menor a -180). Responde HTTP 400 Bad Request con los mensajes de class-validator."
          },
          "response": []
        },
        {
          "name": "7. PATCH - Actualizar tienda (Parcial)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schedule\": \"Lun-Sab 8:00-20:00\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/stores/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["stores", "1"]
            },
            "description": "Actualiza solo el campo schedule de la tienda con ID 1 (HTTP 200). Los demás campos no se modifican."
          },
          "response": []
        },
        {
          "name": "8. DELETE - Eliminar tienda por ID (Éxito)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/stores/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["stores", "1"]
            },
            "description": "Elimina la tienda con ID 1 de la base de datos (HTTP 200). Ejecutar al final de la secuencia de pruebas de tiendas."
