# URL base de la API de GeoFen
API_URL=http://localhost:3000
# Misma clave que SCRAPER_API_KEY en el .env de la API
SCRAPER_API_KEY=cambia-esta-clave
CITY=Pasto
# true: no envia nada a la API, solo muestra lo que enviaria
DRY_RUN=true
# Pausa entre peticiones a sitios web (ms)
REQUEST_DELAY_MS=1500
# Fuentes separadas por coma (file, olimpica)
SOURCES=file
