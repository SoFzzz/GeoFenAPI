{
  "name": "geofen-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Scraper de precios que alimenta la API de GeoFen",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "scrape": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scrape:dry": "tsx src/index.ts --dry-run --source=file,olimpica",
    "scrape:file": "tsx src/index.ts --source=file",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
