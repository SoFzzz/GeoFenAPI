# Puerto HTTP de la API
PORT=3000

# Conexión a PostgreSQL (el puerto 5433 evita chocar con un Postgres local en 5432)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=geofen_user
DB_PASSWORD=geofen_password
DB_NAME=geofen_db

# Sincroniza las entidades con la BD automáticamente (solo desarrollo; en producción va false y se usan migraciones)
DB_SYNCHRONIZE=true

# Ejecuta las migraciones pendientes al arrancar la API (en producción: true junto con DB_SYNCHRONIZE=false)
DB_MIGRATIONS_RUN=false

# Credenciales y puerto de pgAdmin (docker compose)
PGADMIN_EMAIL=admin@geofen.com
PGADMIN_PASSWORD=admin_password
PGADMIN_PORT=5050

# Clave que el scraper envía en el header x-api-key para escribir datos
SCRAPER_API_KEY=cambia-esta-clave

# Límite de peticiones por IP: ventana en ms, máximo global y máximo en /stores/bulk y /prices/bulk (responde 429)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_BULK_LIMIT=10
